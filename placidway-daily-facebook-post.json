    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a Facebook post for PlacidWay's page based ONLY on the article below.\n\nARTICLE TITLE: {{ $json.title }}\nARTICLE SUMMARY: {{ $json.summary }}\nARTICLE TEXT:\n{{ $json.body }}\n\nSTRICT RULES:\n- Use only facts stated in the article. Do not add any outside facts.\n- Do NOT mention any prices, costs, currencies or discounts.\n- Do NOT make medical claims or promise results (no \"cure\", \"guaranteed\", \"proven\", \"best\", \"eliminate pain\").\n- Use cautious, informative language (e.g. \"explore\", \"learn about\", \"options include\").\n- Friendly, professional tone. No more than 1 emoji.\n- Do not include any URL. The link is added separately.\n- Keep the article's caveats. If the article says evidence is limited, a treatment is investigational, or an option is not intended for this condition, do not present it more positively than the article does.\n\n\nReturn ONLY valid JSON, no other text, in this exact format:\n{\n  \"hook\": \"one short attention-grabbing opening line\",\n    \"lines\": [\"2 or 3 short lines of value from the article\"],\n  \"cta\": \"one short call to action inviting people to read the full guide\",\n  \"hashtags\": [\"3 to 5 relevant hashtags, each starting with #\"]\n}\nLENGTH LIMITS (strict):\n- hook: under 80 characters\n- lines: 2 or 3 lines only, each under 110 characters\n- cta: under 70 characters\n- Pick the most important caveat rather than listing every caveat.\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a careful healthcare marketing writer. Accuracy and compliance matter more than hype."
            }
          ]
        },
        "batching": {}
      },
