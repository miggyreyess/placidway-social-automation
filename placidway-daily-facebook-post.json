              "id": "ede967e2-c469-44eb-9c9c-0806e7d265e9",
              "name": "rule_issues",
              "value": "={{ (() => { const t = $json.post_text.split($json.url)[0]; const issues = []; if ($json.chars_before_link >= 500) issues.push('Too long: ' + $json.chars_before_link + ' chars before link'); if ($json.hashtag_count < 3 || $json.hashtag_count > 5) issues.push('Hashtag count ' + $json.hashtag_count + ' (need 3-5)'); if (/[$€£₱฿]|\\b(usd|thb|eur|gbp|php|pesos?|baht|dollars?|prices?|priced|costs?|cheap|discounts?|fees?)\\b/i.test(t)) issues.push('Mentions price or cost'); const banned = t.match(/\\b(cures?|cured|guarantees?|guaranteed|proven|miracle|best|eliminates?|permanent|permanently|risk-free|painless)\\b/gi); if (banned) issues.push('Banned claim words: ' + [...new Set(banned.map(w => w.toLowerCase()))].join(', ')); if (/100\\s?%|no side effects/i.test(t)) issues.push('Absolute claim (100% / no side effects)'); if (($json.post_text.match(/https?:\\/\\//g) || []).length !== 1) issues.push('Post must contain exactly one link'); return issues; })() }}",
              "type": "array"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
